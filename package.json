{
  "name": "portfolio-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fetch-github": "node scripts/fetch-github.mjs",
    "dev": "node scripts/fetch-github.mjs && vite",
    "dev:ssr": "node scripts/fetch-github.mjs && node server.js",
    "build": "node scripts/fetch-github.mjs && vite build",
    "build:ssr": "node scripts/fetch-github.mjs && node scripts/generate-og.mjs && node scripts/generate-poster.mjs && node scripts/generate-icons.mjs && node scripts/prerender.mjs",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/chivo-mono": "^5.2.8",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "sirv": "^2.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
