# GitHub personal access token — used only by server-side builds and API routes
# to fetch profile, repos, languages, pins, and contribution data. Never prefix
# this variable with VITE_, because Vite variables can be exposed to browsers.
# Scopes: public_repo + read:user (classic), or a fine-grained token with
# read access to your public repositories.
GITHUB_TOKEN=

# GitHub username to fetch data for. Defaults to Sami001-OG if unset.
GITHUB_USERNAME=

# Password gating the client-side admin panel (/admin).
VITE_ADMIN_PASSWORD=

# Server-side admin password for the publish API (/api/publish). Falls back to
# VITE_ADMIN_PASSWORD if unset — set both to the same value on Vercel.
ADMIN_PASSWORD=

# "owner/repo" of this site's GitHub repository — the publish API commits
# admin-panel changes to src/data/content.json here, which triggers a
# Vercel redeploy. Example: Sami001-OG/mmmm
CONTENT_REPO=

# Canonical site origin, no trailing slash — used for canonical tags, OG URLs,
# and sitemap.xml. Defaults to https://samish.me if unset.
SITE_URL=
