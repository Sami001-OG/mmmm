# GitHub personal access token — used at build time to fetch profile, repos,
# languages, and contribution data (scripts/fetch-github.mjs). Without it the
# build writes an _empty sentinel and GitHub-driven sections render empty.
# Scopes: public_repo + read:user (classic), or a fine-grained token with
# read access to your public repositories.
GITHUB_TOKEN=

# GitHub username to fetch data for. Defaults to Sami001-OG if unset.
GITHUB_USERNAME=

# Password gating the client-side admin panel (/admin).
VITE_ADMIN_PASSWORD=

# Canonical site origin, no trailing slash — used for canonical tags, OG URLs,
# and sitemap.xml. Defaults to https://sami.dev if unset.
SITE_URL=
